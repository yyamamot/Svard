{
  "name": "svard",
  "displayName": "Svard",
  "description": "Specification Viewer and Rendered Diff for local-first technical documents",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:tauri": "pnpm run tauri:dev",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "pnpm run typecheck && vite build",
    "tauri": "tauri",
    "tauri:dev": "pnpm exec tauri dev",
    "tauri:build": "pnpm run build && pnpm exec tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:check:sccache": "RUSTC_WRAPPER=sccache cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:test:sccache": "RUSTC_WRAPPER=sccache cargo test --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run test/unit src",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test",
    "test:plantuml-local": "node scripts/plantuml-render-suite.mjs",
    "test:plantuml-concurrency": "node scripts/plantuml-concurrency-suite.mjs",
    "test:plantuml-heavy": "node scripts/plantuml-heavy-suite.mjs",
    "test:plantuml-local:extended": "node scripts/plantuml-render-suite.mjs --extended",
    "test:graphviz-local": "node scripts/graphviz-render-suite.mjs",
    "check:plantuml-assets": "node scripts/measure-plantuml-assets.mjs",
    "review:ui:feature": "node scripts/review-ui-feature.mjs",
    "review:ui:llm": "node scripts/review-ui-llm.mjs",
    "review:ui:system": "node scripts/review-ui-system.mjs",
    "smoke:tauri-checklist": "node scripts/tauri-smoke-checklist.mjs",
    "smoke:cross-platform": "node scripts/cross-platform-smoke.mjs",
    "poc:plantuml-teavm": "node scripts/poc-plantuml-teavm.mjs",
    "update:plantuml-teavm-assets": "node scripts/update-plantuml-teavm-assets.mjs",
    "verify:ui-change": "node scripts/verify-ui-change.mjs",
    "verify:render-regression": "node scripts/render-regression-suite.mjs",
    "perf:markdown": "node scripts/markdown-perf-probe.mjs",
    "perf:markdown:budget": "node scripts/markdown-perf-probe.mjs --diagnostic --budget --out .artifacts/perf/markdown-budget.json",
    "perf:asciidoc": "node scripts/asciidoc-perf-probe.mjs",
    "perf:asciidoc:budget": "node scripts/asciidoc-perf-probe.mjs --budget --out .artifacts/perf/asciidoc-budget.json",
    "perf:source-control:file-history": "node scripts/source-control-file-history-perf-probe.mjs",
    "perf:source-control:file-history:budget": "node scripts/source-control-file-history-perf-probe.mjs --budget --out .artifacts/perf/source-control-file-history-budget.json",
    "check:ui-scenarios": "node scripts/check-ui-scenarios.mjs",
    "version:set": "node scripts/set-release-version.mjs",
    "version:check": "node scripts/check-release-version.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm --dir site run build",
    "verify": "pnpm run check"
  },
  "dependencies": {
    "@asciidoctor/core": "3.0.4",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "diff": "^9.0.0",
    "dompurify": "3.4.5",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "katex": "0.17.0",
    "lucide-react": "1.16.0",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "11.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
