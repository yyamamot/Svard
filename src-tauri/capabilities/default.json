{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Svard viewer windows",
  "windows": ["main", "viewer-*"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
