{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Svard",
  "version": "1.0.0",
  "identifier": "io.github.svard.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Svard",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:; frame-src 'self'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "AsciiDoc Document",
        "description": "AsciiDoc markup document",
        "ext": [
          "adoc",
          "asciidoc",
          "asc"
        ],
        "mimeType": "text/asciidoc",
        "role": "Viewer"
      },
      {
        "name": "Markdown Document",
        "description": "Markdown document",
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ]
  }
}
