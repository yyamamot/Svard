---
import { site } from "../../content/site.en";
import LandingLayout from "../../layouts/LandingLayout.astro";
import Hero from "../../components/Hero.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
import PrivacySection from "../../components/PrivacySection.astro";
import DiffSection from "../../components/DiffSection.astro";
import FaqSection from "../../components/FaqSection.astro";
import ReviewFlowSection from "../../components/ReviewFlowSection.astro";
---

<LandingLayout site={site}>
  <Hero content={site.top} />
  <DiffSection content={site.top.diff} locale={site.locale} />
  <ReviewFlowSection content={site.top.reviewFlow} />
  <FeatureGrid items={site.top.highlights} />
  <PrivacySection content={site.top.privacy} locale={site.locale} />
  <FaqSection items={site.top.faq} />
</LandingLayout>
