---
import { site } from "../../../../../content/site.en";
import LandingLayout from "../../../../../layouts/LandingLayout.astro";
import FeatureDocPage from "../../../../../components/FeatureDocPage.astro";

const feature = site.docs.features.privacyModel;
---

<LandingLayout
  site={site}
  pageTitle={feature.title}
  pageDescription={feature.lead}
>
  <FeatureDocPage
    docs={site.docs}
    feature={feature}
    labels={site.docs.articleLabels}
    eyebrow={site.docs.featureEyebrow}
    activeSlug="privacy-model"
  />
</LandingLayout>
