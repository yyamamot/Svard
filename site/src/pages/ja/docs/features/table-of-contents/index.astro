---
import { site } from '../../../../../content/site.ja';
import LandingLayout from '../../../../../layouts/LandingLayout.astro';
import FeatureDocPage from '../../../../../components/FeatureDocPage.astro';

const feature = site.docs.features.tableOfContents;
---

<LandingLayout site={site} pageTitle={feature.title} pageDescription={feature.lead}>
  <FeatureDocPage docs={site.docs} feature={feature} labels={site.docs.articleLabels} eyebrow={site.docs.featureEyebrow} activeSlug="table-of-contents" />
</LandingLayout>
