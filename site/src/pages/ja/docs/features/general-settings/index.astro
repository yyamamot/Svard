---
import FeatureDocPage from "../../../../../components/FeatureDocPage.astro";
import LandingLayout from "../../../../../layouts/LandingLayout.astro";
import { site } from "../../../../../content/site.ja";

const feature = site.docs.features.generalSettings;
---

<LandingLayout
  site={site}
  pageTitle={feature.title}
  pageDescription={feature.lead}
>
  <FeatureDocPage
    docs={site.docs}
    feature={feature}
    labels={site.docs.articleLabels}
    eyebrow={site.docs.featureEyebrow}
    activeSlug="general-settings"
  />
</LandingLayout>
