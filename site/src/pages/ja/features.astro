---
import { site } from "../../content/site.ja";
import LandingLayout from "../../layouts/LandingLayout.astro";
import ScreenshotPlaceholder from "../../components/ScreenshotPlaceholder.astro";
import FeatureGrid from "../../components/FeatureGrid.astro";
---

<LandingLayout
  site={site}
  pageTitle="Features"
  pageDescription={site.features.lead}
>
  <section class="page-hero section-shell">
    <div>
      <p class="eyebrow">{site.features.eyebrow}</p>
      <h1>{site.features.heading}</h1>
      <p class="lead">{site.features.lead}</p>
    </div>
    <ScreenshotPlaceholder screenshot={site.features.screenshot} />
  </section>
  <FeatureGrid items={site.features.sections} />
</LandingLayout>
